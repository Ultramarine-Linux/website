---
import CopyIcon from "~icons/fluent/copy-16-regular";
import CheckIcon from "~icons/fluent/checkmark-16-regular";
import { makeT } from "../i18n";
const t = makeT(Astro.params.lang);
---

<div class="w-full">
  <h2 class="text-3xl font-bold">{t("download.convertTitle")}</h2>
  <p class="pt-1 text-gray-500">{t("migrate.description")}</p>

  <div class="flex flex-row items-center gap-2 mt-8 p-2 pl-6 rounded-lg bg-gray-900 w-full overflow-hidden">
    <pre class="grow overflow-x-auto py-2"><code id="migration-command" class="font-mono text-sm md:text-base text-gray-200">bash {"<"}(curl -s https://ultramarine-linux.org/migrate.sh)</code></pre>
    <button
      type="button"
      id="migration-copy"
      class="shrink-0 flex items-center justify-center w-10 h-10 rounded-md text-gray-400 hover:text-gray-100 hover:bg-gray-800 transition-colors cursor-pointer"
      aria-label={t("migrate.copy")}
    >
      <CopyIcon className="w-5 h-5" data-icon="copy" aria-hidden="true" />
      <CheckIcon className="w-5 h-5 hidden text-green-500" data-icon="check" aria-hidden="true" />
    </button>
  </div>
</div>

<script>
  const button = document.getElementById("migration-copy");
  const code = document.getElementById("migration-command");

  button?.addEventListener("click", async () => {
    if (!code) return;
    const copyIcon = button.querySelector('[data-icon="copy"]');
    const checkIcon = button.querySelector('[data-icon="check"]');
    try {
      await navigator.clipboard.writeText(code.innerText);
      copyIcon?.classList.add("hidden");
      checkIcon?.classList.remove("hidden");
      setTimeout(() => {
        copyIcon?.classList.remove("hidden");
        checkIcon?.classList.add("hidden");
      }, 1500);
    } catch (err) {
      console.error("Failed to copy text: ", err);
    }
  });
</script>
