---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import DownloadLinks from "./DownloadLinks";

interface Screenshot {
  src: ImageMetadata;
  dark?: ImageMetadata;
  alt: string;
  caption?: { title: string; text: string };
}

interface Props {
  editionDisplayName?: string;
  editionName: string;
  screenshots: Screenshot[];
  description: string;
  subtitle?: string;
  version: string;
}

const {
  editionDisplayName,
  editionName,
  screenshots,
  description,
  subtitle,
  version,
} = Astro.props;
---

<section class="w-full">
  <div class="grid grid-cols-1 lg:grid-cols-9 gap-8 lg:gap-12 items-center">
    <div class="lg:col-span-4 flex flex-col gap-6">
      <div>
        <h2 class="edition-title w-fit whitespace-nowrap text-5xl md:text-7xl lg:text-5xl xl:text-6xl font-bold pb-1">
          {editionDisplayName ?? editionName}
        </h2>
        {subtitle && <p class="text-gray-500 font-bold text-lg md:text-xl mt-1">{subtitle}</p>}
        <div class="mb-4"></div>
        <p class="text-base md:text-lg text-gray-300">{description}</p>
      </div>

      <div>
        <DownloadLinks
          edition={editionName.toLowerCase()}
          version={version}
          client:load
          lang={Astro.params.lang}
        />
      </div>
    </div>

    <div class="lg:col-span-5">
      {
        screenshots.slice(0, 1).map((shot) => (
          <div>
            <Image
              src={shot.src}
              alt={shot.alt}
              class={`w-full aspect-[3/2] object-cover rounded-xl shadow-2xl ring-1 ring-white/10 ${shot.dark ? "dark:hidden" : ""}`}
              width={1200}
              loading="eager"
            />
            {shot.dark && (
              <Image
                src={shot.dark}
                alt={shot.alt}
                class="w-full aspect-[3/2] object-cover rounded-xl shadow-2xl ring-1 ring-white/10 hidden dark:block"
                width={1200}
                loading="eager"
              />
            )}
          </div>
        ))
      }
    </div>

    {
      screenshots.length > 1 && (
        <div class="lg:col-span-9 grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-6">
            {screenshots.slice(1, 4).map((shot) => (
              <div>
                <Image
                  src={shot.src}
                  alt={shot.alt}
                  class={`w-full aspect-[3/2] object-cover rounded-lg shadow-xl ring-1 ring-white/10 ${shot.dark ? "dark:hidden" : ""}`}
                  width={600}
                  loading="lazy"
                />
                {shot.dark && (
                  <Image
                    src={shot.dark}
                    alt={shot.alt}
                    class="w-full aspect-[3/2] object-cover rounded-lg shadow-xl ring-1 ring-white/10 hidden dark:block"
                    width={600}
                    loading="lazy"
                  />
                )}
                {shot.caption && (
                  <div class="mt-3">
                    <h3 class="font-semibold text-gray-100">{shot.caption.title}</h3>
                    <p class="text-sm text-gray-400">{shot.caption.text}</p>
                  </div>
                )}
              </div>
            ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .edition-title {
    background-image: url("/texture.avif");
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    line-height: 1.1;
  }
</style>
